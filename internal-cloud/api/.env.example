# PostgreSQL (Supabase에서 덤프한 DB 또는 자체 PG)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT (신규 발급 시 임의의 긴 비밀 문자열. 기존 Supabase 세션과 호환할 필요는 없음)
JWT_SECRET=change-me-to-a-long-random-string

# auth.users.instance_id (Supabase 기본 단일 인스턴스)
AUTH_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# 가입 직후 세션 발급 (내부망 true 권장). false면 이메일 인증 플로우에 맞게 프론트만 조정
AUTH_EMAIL_AUTO_CONFIRM=true

# Edge Functions 와 동일 역할
ADMIN_NOTIFY_SECRET=
PII_ENCRYPTION_SECRET=
ADMIN_ALLOWED_SOURCE_IPS=
# 비우면 차단 없음(내부 클라우드 기본). 특정 IP만 막을 때만 예: 203.0.113.1,198.51.100.2 / OFF 로 명시적 비활성
BOOKING_BLOCKED_SOURCE_IPS=

# 메일 (send-reservation-status-email)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MAIL_FROM=

PORT=3000
